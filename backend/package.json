{
  "name": "flowbit-backend",
  "version": "1.0.0",
  "description": "FlowBit Backend API with multi-tenant support",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo 'Backend build complete'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:tenant": "jest tests/tenantIsolation.test.js",
    "test:schema": "jest tests/schemaDesign.test.js",
    "test:middleware": "jest tests/tenantIsolationMiddleware.test.js",
    "test:seed": "jest tests/seedData.test.js",
    "test:api": "jest tests/apiEndpoints.test.js",
    "seed": "node src/scripts/seedData.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-session": "^1.18.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "isomorphic-dompurify": "^2.26.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "validator": "^13.15.15",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "eslint-config-standard": "^17.1.0",
    "jest": "^29.6.1",
    "mongodb-memory-server": "^8.13.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js"
    ]
  }
}
